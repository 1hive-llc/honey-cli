# Bee / Honey quick-start environment
#
# Copy this file for normal local use:
#   cp .env.example .env
#
# Optional indexed reads:
# - THE_GRAPH_API_KEY improves Gardens/Celeste/Agreement indexed reads.
#
# Advanced signer, fork, subgraph-endpoint, and protocol-address overrides live in:
# - .env.advanced.example
# - .env.protocol.example

# The Graph gateway API key. Used for Gardens proposals and court/agreement diagnostics.
# Create one at The Graph Studio/Gateway. Leave blank for RPC-only functionality.
THE_GRAPH_API_KEY=

# Optional default sender for preview builders when --from is omitted.
AGENT_WALLET_ADDRESS=

# Optional RPC override. If unset, Bee/Honey uses https://rpc.gnosischain.com.
GNOSIS_RPC_URL=
