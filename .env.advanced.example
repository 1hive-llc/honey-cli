# Advanced Bee / Honey environment settings
#
# Do not copy this wholesale unless you are operating fork tests, custom subgraphs,
# or local signer automation. The normal starter file is .env.example.

# Chain / local fork
GNOSIS_CHAIN_ID=100
GNOSIS_RPC_URL=https://rpc.gnosischain.com
GNOSIS_EXPLORER=https://gnosisscan.io
CHIADO_CHAIN_ID=10200
CHIADO_RPC_URL=https://rpc.chiadochain.net

# Local Gnosis fork for opt-in E2E transaction-flow tests.
# Start with: anvil --fork-url $GNOSIS_RPC_URL --chain-id 31337
FORK_CHAIN_ID=31337
FORK_RPC_URL=http://127.0.0.1:8545
RUN_FORK_E2E=0
# Fork-only private key. Never use a mainnet key here; dev-private-key is rejected on chain 100.
FORK_PRIVATE_KEY=
# Optional fixture account with HNY for fork-only impersonation/setup.
FORK_HNY_WHALE=
FORK_EXISTING_PROPOSAL_ID=

# Indexed reads / Graph gateway
# Prefer THE_GRAPH_API_KEY. GRAPH_API_KEY is still accepted by code as a legacy alias,
# but is intentionally omitted from the starter .env.example to avoid duplication.
THE_GRAPH_API_KEY=

# Gardens v1 subgraph overrides. Normally THE_GRAPH_API_KEY plus the built-in
# Gardens Gnosis subgraph ID is enough.
GARDENS_SUBGRAPH_URL=
GARDENS_GNOSIS_SUBGRAPH_URL=
GARDENS_GNOSIS_SUBGRAPH_ID=G4EbcSW588SUy8CdprPPxCN69VN8mxvnwt4oyR6YpGza
GARDENS_CHIADO_SUBGRAPH_URL=
GARDENS_CHIADO_SUBGRAPH_ID=
GARDENS_SUBGRAPH_ID=

# Honey/Celeste subgraph health diagnostics.
# Normally THE_GRAPH_API_KEY plus built-in deployment IDs is enough. Set full URLs
# or IDs only when testing alternate deployments/indexers.
CELESTE_SUBGRAPH_URL=
CELESTE_SUBGRAPH_ID=
CELESTE_SUBGRAPH_DEPLOYMENT_ID=
AGREEMENT_SUBGRAPH_URL=
AGREEMENT_SUBGRAPH_ID=
AGREEMENT_SUBGRAPH_DEPLOYMENT_ID=

# Signing mode / account hints
AGENT_WALLET_ADDRESS=
SAFE_ADDRESS=
SAFE_SERVICE_URL=

# Encrypted keystore autonomy. Passphrases must be loaded from a local file or
# interactive prompt, never supplied as CLI args or Pi tool JSON. Keep .pi/keystore local and backed up.
HONEY_KEYSTORE_DIR=.pi/keystore
HONEY_KEYSTORE_POLICY=.pi/keystore/policy.json
HONEY_KEYSTORE_PASSPHRASE_FILE=
# Prototype/test-only: allow in-process keystore signing from HONEY_KEYSTORE_PASSPHRASE_FILE.
HONEY_KEYSTORE_ALLOW_PASSPHRASE_FILE=0

# Honey signer daemon / external signer. Prefer a protected local socket when available.
HONEY_SIGNER_SOCKET=
HONEY_SIGNER_URL=http://127.0.0.1:19777
HONEY_SIGNER_HOST=127.0.0.1
HONEY_SIGNER_PORT=19777
HONEY_SIGNER_TIMEOUT_MS=30000
HONEY_SIGNER_AUDIT_LOG=.pi/sessions/honey-signer-audit.log
HONEY_SIGNER_PID_FILE=.pi/sessions/honey-signer.pid
