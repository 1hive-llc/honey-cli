{
  "name": "honey-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Honey/1Hive CLI, protocol safety, previews, and signer boundary.",
  "keywords": [
    "honey",
    "1hive",
    "gnosis-chain"
  ],
  "bin": {
    "honey": "bin/honey.mjs",
    "honey-signer": "bin/honey-signer.mjs"
  },
  "files": [
    "bin/",
    "references/",
    "src/",
    "types/",
    ".env.example",
    ".env.*.example",
    "tsconfig.json",
    "THIRD_PARTY_NOTICES.md",
    "docs/ARCHITECTURE.md",
    "docs/AUTHORITY_MODEL.md",
    "docs/CLI_CONTRACT.md",
    "docs/KEYSTORE.md",
    "docs/LOCAL_WEB.md",
    "docs/SAFETY_MODEL.md",
    "docs/SIGNING_BOUNDARY.md",
    "docs/TOOL_REFERENCE.md",
    "examples/governance/",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "graphql-request": "^7.4.0",
    "tsx": "^4.22.4",
    "viem": "^2.53.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "viem": {
      "ws": "8.21.0"
    }
  },
  "license": "MIT"
}
